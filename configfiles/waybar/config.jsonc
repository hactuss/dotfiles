{
  "layer": "top",
  "modules-left": ["niri/workspaces", "niri/mode"],
  "modules-center": ["niri/window"],
  "modules-right": [
    "battery",
    "clock",
    "custom/pavucontrol",
    "custom/shutdown",
  ],
  "niri/window": {
    "max-length": 50,
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}",
  },
  "custom/pavucontrol": {
    "format": "󰕾",
    "tooltip": false,
    "on-click": "pavucontrol",
  },
  "custom/blueman": {
    "format": "b",
    "tooltip": false,
    "on-click": "blueman",
  },
  "custom/shutdown": {
    "format": "shutdown",
    "on-click": "shutdown -P now",
  },
}
